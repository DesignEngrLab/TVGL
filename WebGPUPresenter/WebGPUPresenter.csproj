<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\BugViewer\BugViewer\BugViewer.csproj" />
		<ProjectReference Include="..\TessellationAndVoxelizationGeometryLibrary\TessellationAndVoxelizationGeometryLibrary.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Testing" />
		<InternalsVisibleTo Include="WebGPUPresenter.SceneTests" />
	</ItemGroup>
	<!-- This project is a library hosted by a console application. The Web SDK only adds Blazor's
	     framework script automatically for executable projects, so embed that one required asset here. -->
	<ItemGroup>
		<EmbeddedResource Include="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js" LogicalName="WebGPUPresenter.Framework.blazor.web.js" />
	</ItemGroup>
</Project>
