@using NumericsVector3 = System.Numerics.Vector3
@using BugViewer
@using TVGL
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@namespace WebGPUPresenter.Components
@implements IAsyncDisposable

<section class="scene-viewer">
    <header class="scene-viewer-header">
        <div>
            <span class="scene-id">#@ViewerId</span>
            @if (IsActive)
            {
                <span class="active-badge">Active</span>
            }
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Heading))
            {
                <p>@Heading</p>
            }
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>
        <FluentButton Class="rotated-icon-button" @onclick="CloseAsync" IconStart="@(new Icons.Regular.Size20.Add())" />
    </header>
    @if (StepCount > 1)
    {
        <div class="step-controls">
            <button @onclick="PreviousStepAsync">Prev</button>
            <input type="range" min="0" max="@(StepCount - 1)" @bind="step"
                   @bind:event="oninput" @bind:after="RenderSceneAsync" />
            <span>@(step + 1) / @StepCount</span>
            <button @onclick="NextStepAsync">Next</button>
            <button @onclick="ToggleAutoplayAsync">@(IsAutoplaying ? "Pause" : "Play")</button>
            <label class="step-speed-control">
                Speed
                <select @bind="autoplayDelayMilliseconds">
                    <option value="33">30 fps</option>
                    <option value="100">10 fps</option>
                    <option value="333">3 fps</option>
                    <option value="1000">1 fps</option>
                    <option value="3000">1 frame / 3 sec</option>
                </select>
            </label>
            <label class="step-speed-control">
                Step stride
                <input type="number" min="1" max="@Math.Max(1, StepCount - 1)"
                       @bind="autoplayStepIncrement" />
            </label>
        </div>
    }
    <div class="scene-viewer-canvas">
        <BugViewer @ref="viewer" Height="100%" Width="100%" OnReady="OnViewerReadyAsync"
                   HoverSelectionKeys="inspectionKeys" OnHoverSelectionKeyChanged="InspectionKeyChangedAsync"
                   OnTriangleSelected="TriangleSelectedAsync" AutoResetCamera="Current.AutoResetCamera" />
    </div>
</section>

@code {
    [Parameter] public int ViewerId { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public IReadOnlyList<SceneRequest> Scenes { get; set; } = [];
    [Parameter] public EventCallback<int> OnClose { get; set; }
    [Parameter] public EventCallback OnReady { get; set; }
    [Parameter] public EventCallback<SceneTriangleSelection> OnTriangleSelected { get; set; }

    private int step;
    private int autoplayDelayMilliseconds = 333;
    private int autoplayStepIncrement = 1;
    private CancellationTokenSource? autoplayCancellation;
    private Task? autoplayTask;
    private bool IsAutoplaying => autoplayCancellation is not null;
    private SceneRequest CurrentRequest => Scenes.LastOrDefault()
        ?? new SceneRequest { RequestId = Guid.Empty };
    private SceneRequest Current => CurrentRequest is { Steps.Count: > 0 } stepped
        ? stepped.Steps[Math.Clamp(step, 0, stepped.Steps.Count - 1)]
        : CurrentRequest;
    private int StepCount => CurrentRequest.StepGroups.Count > 0
        ? CurrentRequest.StepGroups.Max(group => group.Count)
        : CurrentRequest.Steps.Count;
    private string Heading => Current.Heading;
    private string Title => Current.Title.Length == 0 ? "TVGL 3D Presenter" : Current.Title;
    private string Subtitle => Current.Subtitle;
    private global::BugViewer.BugViewer? viewer;

    private string? activeInspectionKey;
    private string? coloredMeshId;
    private LineData? inspectionLine;
    private int appliedSceneCount;
    private bool displayPreferencesInitialized;
    private readonly Dictionary<string, MeshData> renderedMeshes = [];
    private readonly Dictionary<string, LineData> renderedLines = [];
    private readonly Dictionary<string, RenderSignature> renderedMeshSignatures = [];
    private readonly Dictionary<string, RenderSignature> renderedLineSignatures = [];
    private readonly SemaphoreSlim renderLock = new(1, 1);
    private readonly object renderRequestGate = new();
    private Task? renderLoopTask;
    private int? pendingRenderStep;
    private bool disposing;
    private readonly IReadOnlyList<string> inspectionKeys = ["g", "v", "f", "p"];

    protected override async Task OnParametersSetAsync()
    {
        if (step >= StepCount)
            step = Math.Max(0, StepCount - 1);
        if (viewer is null || appliedSceneCount == Scenes.Count)
            return;

        await RenderSceneAsync();
    }

    private async Task OnViewerReadyAsync()
    {
        await OnParametersSetAsync();
        await OnReady.InvokeAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync(ViewerId);

    private async Task PreviousStepAsync()
    {
        step = Math.Max(0, step - 1);
        await RenderSceneAsync();
    }

    private async Task NextStepAsync()
    {
        step = Math.Min(StepCount - 1, step + 1);
        await RenderSceneAsync();
    }

    private async Task ToggleAutoplayAsync()
    {
        if (autoplayCancellation is not null)
        {
            await StopAutoplayAsync();
            return;
        }

        autoplayCancellation = new CancellationTokenSource();
        autoplayTask = AutoplayAsync(autoplayCancellation.Token);
        await InvokeAsync(StateHasChanged);
    }

    private async Task AutoplayAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested && StepCount > 1)
            {
                await Task.Delay(autoplayDelayMilliseconds, cancellationToken);
                var increment = Math.Clamp(autoplayStepIncrement, 1, Math.Max(1, StepCount - 1));
                step = (step + increment) % StepCount;
                await RenderSceneAsync();
                if (!cancellationToken.IsCancellationRequested)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task StopAutoplayAsync()
    {
        var cancellation = autoplayCancellation;
        var task = autoplayTask;
        autoplayCancellation = null;
        autoplayTask = null;
        if (cancellation is null)
            return;

        cancellation.Cancel();
        if (task is not null)
            await task;
        cancellation.Dispose();
    }

    private SceneRequest CurrentAtStep(int stepIndex) => CurrentRequest is { Steps.Count: > 0 } stepped
        ? stepped.Steps[Math.Clamp(stepIndex, 0, stepped.Steps.Count - 1)]
        : CurrentRequest;

    private IEnumerable<SceneRequest> VisibleScenes(int stepIndex)
    {
        for (var index = 0; index < Scenes.Count - 1; index++)
            yield return Scenes[index];
        if (Scenes.Count > 0)
            yield return CurrentAtStep(stepIndex);
    }

    private static IEnumerable<(T Element, Matrix4x4? Transform)> ResolveStepElements<T>(
        SceneStepGroup group, IReadOnlyList<T?> elements, int stepIndex)
        where T : class
    {
        var transforms = group.Transforms;
        if (transforms is null)
        {
            foreach (var element in elements)
                if (element is not null)
                    yield return (element, null);
            yield break;
        }

        if (stepIndex >= transforms.Count || transforms[stepIndex].IsNull())
        {
            if (stepIndex < elements.Count && elements[stepIndex] is { } element)
                yield return (element, null);
            yield break;
        }

        var transform = transforms[stepIndex];
        var lowerBound = group.LastNullTransformAtOrBefore(stepIndex) + 1;
        for (var timeIndex = Math.Min(stepIndex, elements.Count - 1); timeIndex >= lowerBound; timeIndex--)
        {
            if (elements[timeIndex] is { } element)
                yield return (element, transform);
        }
    }

    private Task RenderSceneAsync()
    {
        lock (renderRequestGate)
        {
            if (disposing)
                return Task.CompletedTask;
            pendingRenderStep = step;
            renderLoopTask ??= ProcessRenderRequestsAsync();
        }
        return Task.CompletedTask;
    }

    private async Task ProcessRenderRequestsAsync()
    {
        await Task.Yield();
        try
        {
            while (true)
            {
                int stepToRender;
                lock (renderRequestGate)
                {
                    if (pendingRenderStep is not { } requestedStep)
                        return;
                    stepToRender = requestedStep;
                    pendingRenderStep = null;
                }

                await renderLock.WaitAsync();
                try
                {
                    await RenderSceneCoreAsync(stepToRender);
                }
                finally
                {
                    renderLock.Release();
                }
            }
        }
        finally
        {
            lock (renderRequestGate)
            {
                renderLoopTask = null;
                if (!disposing && pendingRenderStep.HasValue)
                    renderLoopTask = ProcessRenderRequestsAsync();
            }
        }
    }

    private async Task RenderSceneCoreAsync(int stepIndex)
    {
        if (viewer is null)
            return;

        var desiredMeshes = new List<MeshData>();
        var desiredLines = new List<LineData>();
        var desiredMeshSignatures = new Dictionary<string, RenderSignature>();
        var desiredLineSignatures = new Dictionary<string, RenderSignature>();
        foreach (var scene in VisibleScenes(stepIndex))
        {
            foreach (var mesh in scene.Meshes)
            {
                desiredMeshes.Add(ToMeshData(mesh));
                desiredMeshSignatures.Add(mesh.Id, new RenderSignature(mesh, null));
            }
            foreach (var path in scene.Paths)
            {
                desiredLines.Add(ToLineData(path));
                desiredLineSignatures.Add(path.Id, new RenderSignature(path, null));
            }
            foreach (var points in scene.PointSets)
            {
                var line = ToPointGlyphs(points);
                desiredLines.Add(line);
                desiredLineSignatures.Add(line.Id, new RenderSignature(points, null));
            }
            foreach (var group in scene.StepGroups)
            {
                foreach (var (mesh, transform) in ResolveStepElements(group, group.Meshes, stepIndex))
                {
                    desiredMeshes.Add(ToMeshData(mesh, transform));
                    desiredMeshSignatures.Add(mesh.Id, new RenderSignature(mesh, transform));
                }
                if (group.PathSource is { } pathSource
                    && StepPathBatchBuilder.Build(group, pathSource, stepIndex) is { } pathBatch)
                {
                    desiredLines.Add(pathBatch);
                    var transform = group.Transforms is not null && stepIndex < group.Transforms.Count
                        && !group.Transforms[stepIndex].IsNull()
                        ? group.Transforms[stepIndex]
                        : (Matrix4x4?)null;
                    desiredLineSignatures.Add(pathBatch.Id,
                        new RenderSignature(pathSource, transform, stepIndex));
                }
            }
        }

        var desiredMeshIds = desiredMeshes.Select(mesh => mesh.Id).ToHashSet();
        var desiredLineIds = desiredLines.Select(line => line.Id).ToHashSet();
        var changedMeshIds = desiredMeshSignatures
            .Where(item => renderedMeshSignatures.TryGetValue(item.Key, out var rendered)
                && rendered != item.Value)
            .Select(item => item.Key).ToHashSet();
        var changedLineIds = desiredLineSignatures
            .Where(item => renderedLineSignatures.TryGetValue(item.Key, out var rendered)
                && rendered != item.Value)
            .Select(item => item.Key).ToHashSet();
        var meshesToRemove = renderedMeshes.Values
            .Where(mesh => !desiredMeshIds.Contains(mesh.Id) || changedMeshIds.Contains(mesh.Id)).ToList();
        var linesToRemove = renderedLines.Values
            .Where(line => !desiredLineIds.Contains(line.Id) || changedLineIds.Contains(line.Id)).ToList();
        var meshesToAdd = desiredMeshes
            .Where(mesh => !renderedMeshes.ContainsKey(mesh.Id) || changedMeshIds.Contains(mesh.Id)).ToList();
        var linesToAdd = desiredLines
            .Where(line => !renderedLines.ContainsKey(line.Id) || changedLineIds.Contains(line.Id)).ToList();

        await viewer.PauseRenderingAsync();
        try
        {
            await ClearInspectionVisualsAsync();
            if (meshesToRemove.Count > 0)
                await viewer.RemoveMeshesAsync(meshesToRemove);
            if (linesToRemove.Count > 0)
                await viewer.RemoveLinesAsync(linesToRemove);
            if (meshesToAdd.Count > 0)
                await viewer.AddMeshesAsync(meshesToAdd);
            if (linesToAdd.Count > 0)
                await viewer.AddLinesAsync(linesToAdd);
            var currentScene = CurrentAtStep(stepIndex);
            if (!displayPreferencesInitialized)
            {
                // Scene requests provide the first view's defaults. After that, the user owns these
                // settings for this viewer: changing frame or scene must not overwrite their choices.
                // Apply the face mode only after meshes are present, because BugViewer otherwise cannot
                // determine whether primitive-surface normals are available.
                displayPreferencesInitialized = true;
                viewer.Options.ShowSurfacesAs = currentScene.ShowSurfacesAs;
                viewer.Options.ShowMeshBorders = currentScene.ShowMeshBorders;
            }
        }
        finally
        {
            await viewer.ResumeRenderingAsync();
        }

        renderedMeshes.Clear();
        foreach (var mesh in desiredMeshes)
            renderedMeshes.Add(mesh.Id, mesh);
        renderedLines.Clear();
        foreach (var line in desiredLines)
            renderedLines.Add(line.Id, line);
        renderedMeshSignatures.Clear();
        foreach (var item in desiredMeshSignatures)
            renderedMeshSignatures.Add(item.Key, item.Value);
        renderedLineSignatures.Clear();
        foreach (var item in desiredLineSignatures)
            renderedLineSignatures.Add(item.Key, item.Value);
        appliedSceneCount = Scenes.Count;
    }

    private async Task TriangleSelectedAsync()
    {
        if (viewer?.SelectedMeshName is not { Length: > 0 } meshId || viewer.SelectedTriangleInMeshIndex < 0)
            return;

        var selected = VisibleSceneMeshes().LastOrDefault(item => item.Mesh.Id == meshId);
        var scene = selected.Scene;
        var mesh = selected.Mesh;
        var face = mesh?.SourceFaces.ElementAtOrDefault(viewer.SelectedTriangleInMeshIndex);
        if (scene is null || mesh is null || face is null)
            return;

        var point = new TVGL.Vector3(viewer.SelectedPoint.X, viewer.SelectedPoint.Y, viewer.SelectedPoint.Z);
        await ApplyInspectionCommandAsync(face, point, mesh, viewer.SelectedTriangleInMeshIndex);
        await OnTriangleSelected.InvokeAsync(new SceneTriangleSelection(scene.RequestId, meshId,
        viewer.SelectedTriangleInMeshIndex, viewer.SelectedPoint));
    }

    private async Task ApplyInspectionCommandAsync(
    TriangleFace face, TVGL.Vector3 point, SceneMesh mesh, int triangleIndex)
    {
        if (viewer is null)
            return;

        if (activeInspectionKey == "g")
        {
            var edge = face.NonNullEdges.MinBy(edge =>
            MiscFunctions.ClosestPointOnLineSegmentToPoint(edge.From.Coordinates, edge.To.Coordinates, point)
            .DistanceSquared(point));
            if (edge is not null)
            {
                await ShowInspectionBillboardAsync(
                $"Edge {edge.IndexInList}; Vector: {edge.Vector}; Length: {edge.Length:G6}",
                edge.Center() + 2 * edge.Normal * viewer.PathThickness);
                await ShowInspectionLineAsync(CreateEdgeHighlight(edge, edge.Normal, viewer.PathThickness));
            }
        }
        else if (activeInspectionKey == "v")
        {
            var vertex = face.Vertices.MinBy(vertex => vertex.Coordinates.DistanceSquared(point));
            if (vertex is not null)
            {
                await ShowInspectionBillboardAsync($"Vertex {vertex.IndexInList}; {vertex.Coordinates}",
                vertex.Coordinates + vertex.Normal * viewer.PathThickness);
                await ShowInspectionLineAsync(
                CreateVertexHighlight(vertex.Coordinates + vertex.Normal * viewer.PathThickness));
            }
        }
        else if (activeInspectionKey == "f")
        {
            await ShowInspectionBillboardAsync(
            $"Face {face.IndexInList}; Normal: {face.Normal}", 
            face.Center + 2 * face.Normal * viewer.PathThickness);
            var colors = ExpandedColors(mesh);
            colors[triangleIndex] = FaceHighlightColor;
            await ApplyMeshColorsAsync(mesh, colors);
        }
        else if (activeInspectionKey == "p")
        {
            var primitive = face.BelongsToPrimitive;
            if (primitive is null)
                return;

            await ShowInspectionBillboardAsync(primitive.KeyString, primitive.CenterOfBoundingBox
            + 2 * face.Normal * viewer.PathThickness);
            var highlight = primitive switch
            {
                Plane => new ColorRgba(0, 255, 0),
                Cylinder => new ColorRgba(255, 0, 0),
                Cone => new ColorRgba(255, 165, 0),
                Sphere => new ColorRgba(255, 255, 0),
                Torus => new ColorRgba(255, 192, 203),
                Prismatic => new ColorRgba(128, 0, 128),
                _ => new ColorRgba(128, 128, 128)
            };
            var primitiveFaceIndices = primitive.Faces.Select(primitiveFace => primitiveFace.IndexInList).ToHashSet();
            var baseColors = ExpandedColors(mesh);
            var colors = mesh.SourceFaces.Select((sourceFace, index) =>
            ReferenceEquals(sourceFace.BelongsToPrimitive, primitive) ||
            primitiveFaceIndices.Contains(sourceFace.IndexInList)
            ? highlight
            : baseColors[index])
            .ToList();
            await ApplyMeshColorsAsync(mesh, colors);
        }
    }

    private static readonly ColorRgba InspectionHighlightColor = new(255, 255, 0, 160);
    private static readonly ColorRgba FaceHighlightColor = new(255, 255, 0, 255);
    private static readonly ColorRgba TransparentColor = new(0, 0, 0, 0);

    private async Task InspectionKeyChangedAsync(string? key)
    {
        activeInspectionKey = key;
        await ClearInspectionVisualsAsync();
    }

    private async Task ClearInspectionVisualsAsync()
    {
        if (viewer is null)
            return;

        await viewer.ClearAllTextBillboardsAsync();
        if (inspectionLine is not null)
        {
            await viewer.RemoveLinesAsync(inspectionLine);
            inspectionLine = null;
        }
        await RestoreColoredMeshAsync();
    }

    private async Task ApplyMeshColorsAsync(SceneMesh mesh, List<ColorRgba>
    colors)
    {
        if (viewer is null)
            return;
        if (coloredMeshId is not null && coloredMeshId != mesh.Id)
            await RestoreColoredMeshAsync();

        await viewer.ChangeMeshColorsAsync(mesh.Id, colors);
        coloredMeshId = mesh.Id;
    }

    private async Task RestoreColoredMeshAsync()
    {
        if (viewer is null || coloredMeshId is null)
            return;

        var meshId = coloredMeshId;
        coloredMeshId = null;
        var mesh = VisibleSceneMeshes().Select(item => item.Mesh)
            .LastOrDefault(candidate => candidate.Id == meshId);
        if (mesh is not null)
            await viewer.ChangeMeshColorsAsync(mesh.Id, ExpandedColors(mesh));
    }

    private async Task ShowInspectionLineAsync(LineData line)
    {
        if (viewer is null)
            return;

        if (inspectionLine is not null)
            await viewer.RemoveLinesAsync(inspectionLine);
        await viewer.AddLinesAsync(line);
        inspectionLine = line;
    }

    private LineData CreateEdgeHighlight(Edge edge, TVGL.Vector3 normal, double outset) => new()
    {
        Id = "InspectionHighlight",
        Vertices =
        [ ToNumerics(edge.From.Coordinates + normal * outset),
            ToNumerics(edge.To.Coordinates + normal * outset)
        ],
        Colors = [InspectionHighlightColor, TransparentColor],
        Thicknesses = [2 * viewer.PathThickness, 0f],
        FadeFactors = [0f, 0f]
    };

    private LineData CreateVertexHighlight(TVGL.Vector3 coordinate)
    {
        var radius = viewer.PathThickness;
        var vertices = new List<NumericsVector3>
        {
            ToNumerics(coordinate + new TVGL.Vector3(-radius, 0, 0)),
            ToNumerics(coordinate + new TVGL.Vector3(radius, 0, 0)),
            ToNumerics(coordinate + new TVGL.Vector3(0, -radius, 0)),
            ToNumerics(coordinate + new TVGL.Vector3(0, radius, 0)),
            ToNumerics(coordinate + new TVGL.Vector3(0, 0, -radius)),
            ToNumerics(coordinate + new TVGL.Vector3(0, 0, radius))
        };
        radius *= 2;
        return new LineData
        {
            Id = "InspectionHighlight",
            Vertices = vertices,
            Colors = [InspectionHighlightColor, TransparentColor,
                InspectionHighlightColor, TransparentColor,
                InspectionHighlightColor, TransparentColor],
            Thicknesses = [radius, 0f, radius, 0f, radius, 0f],
            FadeFactors = Enumerable.Repeat(0f, vertices.Count)
        };
    }

    private static NumericsVector3 ToNumerics(TVGL.Vector3 position) =>
    new((float)position.X, (float)position.Y, (float)position.Z);

    private async Task ShowInspectionBillboardAsync(string text, TVGL.Vector3 position)
    {
        if (viewer is null)
            return;

        await viewer.ClearAllTextBillboardsAsync();
        await viewer.AddTextBillboardAsync("InspectionInfo", text, ToNumerics(position),
              new ColorRgba(255, 255, 224, 230), new ColorRgba(0, 0, 0), 10 * viewer.PathThickness, 0f, 1f);
    }


    private static List<ColorRgba> ExpandedColors(SceneMesh mesh)
    {
        if (mesh.HasUniformColor)
        {
            var color = mesh.Colors.Count > 0 ? mesh.Colors[0] : ColorRgba.LightGray;
            return Enumerable.Repeat(color, mesh.Triangles.Count).ToList();
        }
        return mesh.Colors.ToList();
    }


    private IEnumerable<(SceneRequest Scene, SceneMesh Mesh)> VisibleSceneMeshes()
    {
        foreach (var scene in VisibleScenes(step))
        {
            foreach (var mesh in scene.Meshes)
                yield return (scene, mesh);
            foreach (var group in scene.StepGroups)
                foreach (var (mesh, _) in ResolveStepElements(group, group.Meshes, step))
                    yield return (scene, mesh);
        }
    }

    private static NumericsVector3 TransformVertex(float[] vertex, Matrix4x4? transform)
    {
        if (transform is null)
            return new NumericsVector3(vertex[0], vertex[1], vertex[2]);

        var transformed = new TVGL.Vector3(vertex[0], vertex[1], vertex[2]).Transform(transform.Value);
        return ToNumerics(transformed);
    }

    private static NumericsVector3 TransformNormal(float[] normal, Matrix4x4? normalTransform,
        bool transformIsValid)
    {
        if (!transformIsValid)
            return NumericsVector3.Zero;

        var transformed = new TVGL.Vector3(normal[0], normal[1], normal[2]);
        if (transformed.IsNull() || transformed.LengthSquared() <= 1e-20)
            return NumericsVector3.Zero;
        if (normalTransform is not null)
            transformed = transformed.TransformNoTranslate(normalTransform.Value);
        if (transformed.IsNull() || transformed.LengthSquared() <= 1e-20)
            return NumericsVector3.Zero;
        return ToNumerics(transformed.Normalize());
    }

    private MeshData ToMeshData(SceneMesh mesh, Matrix4x4? transform = null)
    {
        Matrix4x4? normalTransform = null;
        var transformIsValid = true;
        if (transform is not null)
        {
            transformIsValid = Matrix4x4.Invert(transform.Value, out var inverse);
            if (transformIsValid)
                normalTransform = Matrix4x4.Transpose(inverse);
        }

        return new MeshData
        {
            Id = mesh.Id,
            Vertices = mesh.Vertices.Select(vertex => TransformVertex(vertex, transform)).ToList(),
            Indices = mesh.Triangles.Select(t => (t[0], t[1], t[2])).ToList(),
            PrimitiveSurfaceNormals = mesh.PrimitiveSurfaceNormals
                .Select(normal => TransformNormal(normal, normalTransform, transformIsValid)).ToList(),
            HasPrimitiveSurfaces = mesh.HasPrimitiveSurfaces,
            Colors = ExpandedColors(mesh),
            ColorMode = MeshColoring.PerTriangle
        };
    }

    private LineData ToLineData(ScenePath path, Matrix4x4? transform = null)
    {
        var segmentCount = Math.Max(0, path.Vertices.Count - 1);
        var color = new ColorRgba(path.Color.R, path.Color.G, path.Color.B, path.Color.A);
        // Preserve automatic thickness until BugViewer has added every object in this scene to its bounds.
        return new LineData
        {
            Id = path.Id,
            Vertices = path.Vertices.Select(vertex => TransformVertex(vertex, transform)).ToList(),
            Thicknesses = Enumerable.Repeat(path.Thickness < 0
                ? LineData.AutomaticThickness
                : (float)path.Thickness, segmentCount).ToList(),
            Colors = Enumerable.Repeat(color, segmentCount).ToList(),
            FadeFactors = Enumerable.Repeat(0f, segmentCount).ToList()
        };
    }

    // BugViewer currently exposes meshes and lines. Three crossed line segments provide a compact,
    // camera-readable diagnostic point glyph until its WebGPU point primitive is available.
    private LineData ToPointGlyphs(ScenePointSet points)
    {
        var d = viewer.PathThickness / 2;
        var vertices = new List<NumericsVector3>();
        foreach (var p in points.Points)
        {
            vertices.Add(new NumericsVector3(p[0] - d, p[1], p[2])); vertices.Add(new NumericsVector3(p[0] + d, p[1], p[2]));
            vertices.Add(new NumericsVector3(p[0], p[1] - d, p[2])); vertices.Add(new NumericsVector3(p[0], p[1] + d, p[2]));
            vertices.Add(new NumericsVector3(p[0], p[1], p[2] - d)); vertices.Add(new NumericsVector3(p[0], p[1], p[2] + d));
        }
        var count = Math.Max(0, vertices.Count - 1);
        var color = new ColorRgba(points.Color.R, points.Color.G, points.Color.B, points.Color.A);
        return new LineData
        {
            Id = points.Id,
            Vertices = vertices,
            Thicknesses = Enumerable.Repeat(viewer.PathThickness, count).ToList(),
            Colors = Enumerable.Repeat(color, count).ToList(),
            FadeFactors = Enumerable.Repeat(0f, count).ToList()
        };
    }

    public async ValueTask DisposeAsync()
    {
        await StopAutoplayAsync();
        Task? pendingRender;
        lock (renderRequestGate)
        {
            disposing = true;
            pendingRenderStep = null;
            pendingRender = renderLoopTask;
        }
        if (pendingRender is not null)
            await pendingRender;
        await renderLock.WaitAsync();
        renderLock.Release();
        renderLock.Dispose();
    }

    private readonly record struct RenderSignature(object Source, Matrix4x4? Transform, int StepIndex = -1);
}
