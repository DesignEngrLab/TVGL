@page "/"
@implements IAsyncDisposable
@using TVGL
@using Microsoft.FluentUI.AspNetCore.Components
@inject LocalPresenterHost Host
@inject IJSRuntime JS

<PageTitle>TVGL 3D Presenter</PageTitle>
<main class="presenter-page">
    @foreach (var scene in viewerStack)
    {
        <WebGPUPresenter.Components.SceneViewer @key="scene.Id" @ref="scene.Viewer" ViewerId="scene.Id" IsActive="scene.Id == activeViewerId" Scenes="scene.Scenes" OnClose="CloseViewerAsync" OnReady="ViewerReadyAsync" OnTriangleSelected="TriangleSelectedAsync" />
    }
</main>
<footer class="presenter-controls">
    <label><input type="radio" checked="@(nextScenePolicy == ScenePolicy.Clear)" @onchange="@(() => nextScenePolicy = ScenePolicy.Clear)" /> Clear (C)</label>
    <label><input type="radio" checked="@(nextScenePolicy == ScenePolicy.Save)" @onchange="@(() => nextScenePolicy = ScenePolicy.Save)" /> Save Scene (N)</label>
    <label><input type="radio" checked="@(nextScenePolicy == ScenePolicy.Hold)" @onchange="@(() => nextScenePolicy = ScenePolicy.Hold)" /> Hold (H)</label>
    <button @onclick="ContinueAsync">Continue</button>
    <button type="button" data-presenter-save @onclick="SaveActiveSceneAsync" disabled="@(!CanSaveActiveScene)"
            title="Save scene as (Ctrl+Alt+S)" aria-label="Save scene as" aria-keyshortcuts="Control+Alt+S">
        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Save())" />
    </button>
</footer>

@code {
    private readonly List<ViewerScene> viewerStack = [new(1)];
    private ScenePolicy nextScenePolicy = ScenePolicy.Clear;
    private int activeViewerId = 1;
    private int nextViewerId = 2;
    private bool viewerReady;
    private bool scrollToNewestViewer;
    private PresentationPageInterop? pageInterop;
    private DotNetObjectReference<Home>? keyboardReference;
    private ViewerScene? ActiveViewer => viewerStack.LastOrDefault(v => v.Id == activeViewerId);
    private bool CanSaveActiveScene => ActiveViewer is { Viewer: not null, Scenes.Count: > 0 };
    private Task SaveActiveSceneAsync() => ActiveViewer?.Viewer?.ShowSaveAsAsync() ?? Task.CompletedTask;

    protected override void OnInitialized()
    {
        Host.SceneRequested += ReceiveSceneAsync;
    }

    private async Task ViewerReadyAsync()
    {
        if (!viewerReady)
        {
            viewerReady = true;
            await Host.Ready();
        }
    }

    private async Task ReceiveSceneAsync(PresenterRequest request)
    {
        await InvokeAsync(() =>
        {
            ViewerScene? active;
            if (!request.IsBlocking && request.PersistentId >= 0)
                active = viewerStack.LastOrDefault(v => v.PersistentId == request.PersistentId && v.Kind == request.Kind);
            else
                active = viewerStack.LastOrDefault(v => v.Id == activeViewerId);
            if (active is not null && active.Kind != request.Kind)
            {
                if (request.IsBlocking && nextScenePolicy == ScenePolicy.Clear)
                    viewerStack.Remove(active);
                active = null;
            }
            if (request.IsBlocking && (nextScenePolicy == ScenePolicy.Save || active is null) ||
                !request.IsBlocking && active is null)
            {
                active = new ViewerScene(nextViewerId++, request.Kind, request.PersistentId);
                viewerStack.Add(active);
                activeViewerId = active.Id;
            }
            else if ((request.IsBlocking && nextScenePolicy == ScenePolicy.Clear) ||
                     (!request.IsBlocking && request.HoldType == HoldType.Immediate)) active.Scenes.Clear();
            active.Scenes.Add(request);
            scrollToNewestViewer = true;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        pageInterop ??= new PresentationPageInterop(JS);
        if (firstRender)
        {
            keyboardReference = DotNetObjectReference.Create(this);
            await pageInterop.RegisterKeyboardShortcutsAsync(keyboardReference);
        }

        if (!scrollToNewestViewer)
            return;

        scrollToNewestViewer = false;
        await pageInterop.ScrollToNewestViewerAsync();
    }

    [JSInvokable]
    public async Task ContinueWithPolicy(string policy)
    {
        if (!Enum.TryParse<ScenePolicy>(policy, ignoreCase: true, out var selectedPolicy))
            return;

        await InvokeAsync(async () =>
        {
            nextScenePolicy = selectedPolicy;
            await ContinueAsync();
        });
    }

    private async Task ContinueAsync()
    {
        // Clear means discard the active BugViewer as well as releasing the TVGL call,
        // exactly like its Close button. The next scene will therefore create a new viewer.
        if (nextScenePolicy == ScenePolicy.Clear)
        {
            var active = viewerStack.LastOrDefault(v => v.Id == activeViewerId);
            if (active is not null)
            {
                viewerStack.Remove(active);
                activeViewerId = viewerStack.LastOrDefault()?.Id ?? 0;
            }
        }

        await Host.Release();
    }

    private Task TriangleSelectedAsync(SceneTriangleSelection selection)
    {
        Host.Selected(selection);
        return Task.CompletedTask;
    }

    private async Task CloseViewerAsync(int viewerId)
    {
        viewerStack.RemoveAll(v => v.Id == viewerId);
        if (viewerId == activeViewerId)
        {
            activeViewerId = viewerStack.LastOrDefault()?.Id ?? 0;
            await Host.Release();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Host.SceneRequested -= ReceiveSceneAsync;
        Host.BrowserDisconnected();
        if (pageInterop is not null)
            await pageInterop.DisposeAsync();
        keyboardReference?.Dispose();
    }
    private sealed class ViewerScene(int id, PresentationKind kind = PresentationKind.ThreeDimensional, int persistentId = -1)
    {
        public int Id { get; } = id;
        public PresentationKind Kind { get; } = kind;
        public int PersistentId { get; } = persistentId;
        public List<SceneRequest> Scenes { get; } = [];
        public WebGPUPresenter.Components.SceneViewer? Viewer { get; set; }
    }
    private enum ScenePolicy { Clear, Save, Hold }
}
