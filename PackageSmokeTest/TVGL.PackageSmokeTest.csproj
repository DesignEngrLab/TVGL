<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TVGLPackageVersion Condition="'$(TVGLPackageVersion)' == ''">2.0.0</TVGLPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- This must remain a PackageReference: the test verifies the packed artifact, not the source project. -->
    <PackageReference Include="TVGL" Version="$(TVGLPackageVersion)" />
  </ItemGroup>

</Project>
